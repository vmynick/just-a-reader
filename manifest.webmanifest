{
  "name": "Just A Reader",
  "short_name": "Just A Reader",
  "description": "Szavanként villantó gyorsolvasó: saját szövegek és e-könyvek.",
  "lang": "hu",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#161a33",
  "theme_color": "#161a33",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/epub+zip", ".epub", "text/plain", ".txt", "application/pdf", ".pdf", "text/html", ".html", ".htm", ".fb2", "application/zip", ".zip"]
        }
      ]
    }
  }
}
